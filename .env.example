# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# Wajib: API key dari https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Wajib: nama model OpenAI yang tersedia di akun kamu (cek https://platform.openai.com/docs/models)
# Contoh: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Opsional
PORT=3000
# Batas token output per permintaan
OPENAI_MAX_OUTPUT_TOKENS=8000
# Batas permintaan per IP per menit (batas penggunaan di sisi aplikasi)
RATE_LIMIT_PER_MIN=20
# Origin yang boleh memanggil API dari domain lain (pisahkan koma).
# Untuk APK Capacitor (androidScheme http): http://localhost  (atau * saat uji coba)
# Kosongkan jika frontend & backend satu domain.
ALLOWED_ORIGINS=
